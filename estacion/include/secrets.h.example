#pragma once

// ── WiFi (red de respaldo; las últimas 2 usadas se guardan en NVS) ──
#define WIFI_SSID_FALLBACK      "TU_SSID"
#define WIFI_PASSWORD_FALLBACK  "TU_PASSWORD"

// ── Portal de aprovisionamiento (SoftAP cuando no conecta) ─────────
#define AP_SSID      "Alimentadora-Setup"
#define AP_PASSWORD  "cambiar_esto"

// ── Firebase Realtime Database ─────────────────────────────────────
// Console → Configuración del proyecto → Cuentas de servicio →
// Secretos de base de datos
#define FIREBASE_HOST  "TU_PROYECTO-default-rtdb.firebaseio.com"
#define FIREBASE_AUTH  "TU_DATABASE_SECRET"
