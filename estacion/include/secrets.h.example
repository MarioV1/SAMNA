/*
 * secrets.h.example
 * ------------------------------------------------------------------
 * Copia este archivo a  include/secrets.h  y rellena tus credenciales.
 * secrets.h está en .gitignore — NUNCA lo subas al repositorio.
 * ------------------------------------------------------------------
 */

#pragma once

// ── Portal de aprovisionamiento (SoftAP cuando no conecta) ─────────
//
// Las credenciales WiFi NO se compilan: se aprovisionan desde el móvil por
// este portal y viven en NVS (las 2 últimas redes que funcionaron).
//
// AP_PASSWORD necesita 8 caracteres como mínimo. Con menos, WPA2 no puede
// aplicarse y el punto de acceso quedaría ABIERTO — hay un static_assert en
// wifi_link.cpp que lo impide al compilar.
#define AP_SSID      "Alimentadora-Setup"
#define AP_PASSWORD  "cambiar_esto"

// ── Firebase Realtime Database ─────────────────────────────────────
// Console → Configuración del proyecto → Cuentas de servicio →
// Secretos de base de datos
//
// El host es el de TU proyecto de Firebase: aparece en la consola, arriba
// del árbol de la Realtime Database, con la forma
// <id-del-proyecto>-default-rtdb.firebaseio.com
#define FIREBASE_HOST  "TU_PROYECTO-default-rtdb.firebaseio.com"
#define FIREBASE_AUTH  "TU_DATABASE_SECRET"
