# ── PlatformIO ───────────────────────────────────────────────
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json

# ── Credenciales — NUNCA subir ───────────────────────────────
**/include/secrets.h
**/src/secrets.h

# ── VS Code ──────────────────────────────────────────────────
# Sin anclar a la raiz: cubre tambien piscina/.vscode y estacion/.vscode,
# que PlatformIO regenera con rutas absolutas de cada maquina.
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json


# ── Sistema ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~

# ── Datos de pruebas (opcional: quitar si quieres versionarlos)
/datos/*.csv
/datos/*.log
